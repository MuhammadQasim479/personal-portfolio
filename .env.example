# EmailJS credentials for the contact form.
# Copy this file to `.env.local` and fill in the values from
# https://dashboard.emailjs.com — Vite only exposes VITE_-prefixed vars.
#
# Without these three the form still renders, but submitting shows a
# "not configured" message instead of failing silently.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
